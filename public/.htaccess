# LP CONSULTING : configuration Apache (racine web = dossier public/)
Options -Indexes -MultiViews
DirectoryIndex index.php
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS + www
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.lp-consulting.re%{REQUEST_URI} [L,R=301]

  # Fichiers cachés (.git, .env…) interdits
  RewriteRule (^|/)\. - [F]

  # Tout ce qui n'est pas un fichier existant passe par le contrôleur frontal (adresses sans extension)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [L,QSA]
</IfModule>

# Aucun script PHP appelable directement, sauf le contrôleur frontal
<FilesMatch "\.(php|phtml|phar)$">
  Require all denied
</FilesMatch>
<Files "index.php">
  Require all granted
</Files>

# Cache navigateur : 1 an pour les images, polices, CSS et JS.
# CSS et JS sont appelés avec ?v=date de modification : une nouvelle version change d'adresse.
# Une image remplacée doit changer de nom (les envois de l'administration ont toujours un nom nouveau).
# Les pages PHP ne sont pas concernées : leur en-tête Cache-Control (5 minutes) vient de SecurityHeaders.php.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2|webp|jpe?g|png|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Compression (Brotli si le serveur le propose, sinon gzip)
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Fichiers sensibles : jamais servis, même déposés ici par erreur
<FilesMatch "(\.(sql|env|log|ini|bak)|^config(\.[a-z]+)?\.php)$">
  Require all denied
</FilesMatch>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType application/javascript .js
</IfModule>
